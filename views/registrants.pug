doctype html
html
  head
    title= title
    link(rel='stylesheet' href='/css/styles.css')

  body
    div.listing-reg
      if registrations.length
        table.listing-table
          tr
            th Name
            th Email
          each registration in registrations
            tr
              td= registration.name
              td= registration.email
      else
        p No registrations yet :(